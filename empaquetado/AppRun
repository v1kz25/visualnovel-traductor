#!/bin/sh
# Punto de entrada del AppImage: el Python portable que va dentro, con las bibliotecas añadidas.
AQUI="$(dirname "$(readlink -f "$0")")"
export LD_LIBRARY_PATH="$AQUI/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PYTHONNOUSERSITE=1
exec "$AQUI/usr/python/bin/python3" -m vn_audiolibro "$@"
